# Credential NAMES only — never put a value in this file.
# Copy to .env (gitignored) and fill in the values locally.
# The pre-commit hook (scripts/pre-commit-secret-scan.sh) blocks any tracked file
# that contains a live credential value, including this one.

# GitHub personal access token (repo scope). Also used as the git remote password.
GITHUB_TOKEN=

# Hugging Face access token. NOTE: the token previously stored under this name
# belongs to user "opclown1" and is EXPIRED; unauthenticated downloads work for
# every public dataset this project uses. Renew before relying on it.
HUGGINGFACE_TOKEN=

# Kaggle API key (username is in the notes file as KAGGLE_USERNAME).
KAGGLE_KEY=
KAGGLE_USERNAME=

# CryptoHFTData API key — https://www.cryptohftdata.com
CRYPTOHFTDATA_API_KEY=

# Databento API key — required for multi-year CME (NQ/ES) 1-minute history.
# Not yet obtained: this is the project's main data blocker.
DATABENTO_API_KEY=
