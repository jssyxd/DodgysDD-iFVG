# ---- CI workflow ----
# The project token carries only the `repo` scope. GitHub refuses both a git
# push and a REST tree entry for files under .github/workflows/ without the
# `workflow` scope, so ci.yml is kept locally until such a token exists.
.github/workflows/ci.yml
